{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "skipLibCheck": true,
        "strict": false,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["nodes/**/*.ts", "credentials/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
